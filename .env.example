# Copy this file to .env and fill in real values.
# .env is in .gitignore and must never be committed.

# API key for Google's Gemini model. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Flask's secret key, used to sign session cookies. Any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-flask-secret-key-here

# "development" enables Flask's debug mode (auto-reload, detailed error pages).
# Set to "production" when deploying.
FLASK_ENV=development
